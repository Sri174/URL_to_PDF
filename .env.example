# Example .env for URL to PDF Converter
# RUN_MODE: 'local' allows converting local network URLs (run the service on your PC)
#           'render' restricts conversions to publicly reachable URLs (for cloud deployments)
RUN_MODE=render

# Set this to your production Angular frontend URL so CORS allows it
ANGULAR_URL=https://your-production-frontend.example.com

# Optional: port used locally
PORT=8000
